<blocks>
    <!-- make tires pickable -->
    <append xpath="/blocks/block[contains(@name, 'TireSmallFlat') or contains(@name, 'CarTireFlat') or contains(@name, 'CarWheelFlat')]">
        <property name="CanPickup" value="true"/>
    </append>

    <!-- make broken vending machines lootable instead of dropping loot when destroyed -->
    <append xpath="/blocks/block[@name='cntVendingMachine2Broken']">
        <property name="Class" value="Loot"/>
        <property name="LootList" value="vendingMachineDrinkBroken"/>
        <dropextendsoff/>
    </append>

    <append xpath="/blocks/block[@name='cntVendingMachineSnacksFullBroken']">
        <property name="Class" value="Loot"/>
        <property name="LootList" value="vendingMachineFoodBroken"/>
        <dropextendsoff/>
    </append>

    <append xpath="/blocks/block[@name='cntVendingMachineSnacksEmptyBroken']">
        <property name="Class" value="Loot"/>
        <property name="LootList" value="vendingMachineFoodBroken"/>
        <dropextendsoff/>
    </append>
</blocks>	