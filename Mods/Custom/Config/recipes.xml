<recipes>
    <!-- change wheel crafting to use scrap tires -->
    <remove xpath="/recipes/recipe[@name='vehicleWheels']" />

    <append xpath="/recipes">
        <recipe name="vehicleWheels" count="1" tags="perkGreaseMonkey,learnable,packMuleCrafting">
            <ingredient name="resourceForgedIron" count="4"/>
            <ingredient name="resourceScrapPolymers" count="16"/>
            <ingredient name="decoCarTireFlat" count="1"/>
            <effect_group>
                <passive_effect name="CraftingIngredientCount" operation="perc_add" level="0" value=".5" tags="resourceForgedIron,resourceScrapPolymers"/>
            </effect_group>
        </recipe>
        <recipe name="vehicleWheels" count="1" tags="perkGreaseMonkey,learnable,packMuleCrafting">
            <ingredient name="resourceForgedIron" count="4"/>
            <ingredient name="resourceScrapPolymers" count="16"/>
            <ingredient name="decoCarTireSmallFlat" count="1"/>
            <effect_group>
                <passive_effect name="CraftingIngredientCount" operation="perc_add" level="0" value=".5" tags="resourceForgedIron,resourceScrapPolymers"/>
            </effect_group>
        </recipe>
        <recipe name="vehicleWheels" count="1" tags="perkGreaseMonkey,learnable,packMuleCrafting">
            <ingredient name="resourceForgedIron" count="4" />
            <ingredient name="resourceScrapPolymers" count="16"/>
            <ingredient name="decoCarTireFlat02" count="1"/>
            <effect_group>
                <passive_effect name="CraftingIngredientCount" operation="perc_add" level="0" value=".5" tags="resourceForgedIron,resourceScrapPolymers"/>
            </effect_group>
        </recipe>
        <recipe name="vehicleWheels" count="1" tags="perkGreaseMonkey,learnable,packMuleCrafting">
            <ingredient name="resourceForgedIron" count="4" />
            <ingredient name="resourceScrapPolymers" count="16"/>
            <ingredient name="decoCarTireSmallFlat02" count="1"/>
            <effect_group>
                <passive_effect name="CraftingIngredientCount" operation="perc_add" level="0" value=".5" tags="resourceForgedIron,resourceScrapPolymers"/>
            </effect_group>
        </recipe>
    </append>

    <!-- change charred and grilled meat recipes to use 2 raw meat instead of 5 -->
    <set xpath="/recipes/recipe[@name='foodCharredMeat']/ingredient[@name='foodRawMeat']/@count">2</set>
    <set xpath="/recipes/recipe[@name='foodGrilledMeat']/ingredient[@name='foodRawMeat']/@count">2</set>
</recipes>