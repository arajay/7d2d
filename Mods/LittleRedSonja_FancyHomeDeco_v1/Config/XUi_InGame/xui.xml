<LittleRedSonja>

	<conditional>
	<if cond="mod_loaded('XRamosZUI')">

		<append xpath="/xui">
		
			<window_group name="workstation_electricStoveSonjaFunctional" controller="XUiC_WorkstationWindowGroup" open_backpack_on_open="true" close_compass_on_open="true">
				<window name="windowCraftingListCampfire"/>
				<window name="craftingInfoPanel"/>
				<window name="windowCraftingQueue"/>
				<window name="windowToolsCampfire" />
				<window name="windowFuel" />
				<window name="windowOutput" />
				<window name="windowNonPagingHeader" />
			</window_group>
		
		</append>
		
	</if>
	
	<if cond="mod_loaded('zSMXui')">

		<append xpath="/xui">
	
			<window_group name="workstation_electricStoveSonjaFunctional" controller="XUiC_WorkstationWindowGroup" open_backpack_on_open="true" close_compass_on_open="true" defaultSelected="bp.content">
				<window name="windowCraftingListCampfire"/>
				<window name="craftingInfoPanel"/>
				<window name="windowCraftingQueueWorkstation"/>
				<window name="windowToolsCampfire" />
				<window name="windowFuel" />
				<window name="windowOutput" />
				<window name="windowNonPagingHeader" />
			</window_group>
		
		</append>

	</if>
	
	<else>

		<append xpath="/xui">
		
			<window_group name="workstation_electricStoveSonjaFunctional" controller="XUiC_WorkstationWindowGroup" open_backpack_on_open="true" close_compass_on_open="true">
				<window name="windowCraftingList"/>
				<window name="craftingInfoPanel"/>
				<window name="windowCraftingQueue"/>
				<window name="windowToolsCampfire" />
				<window name="windowFuel" />
				<window name="windowOutput" />
				<window name="windowNonPagingHeader" />
			</window_group>
		
		</append>
	
	</else>
	</conditional>
	
</LittleRedSonja>